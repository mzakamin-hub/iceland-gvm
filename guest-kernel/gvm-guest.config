# gvm-guest.config - fragment on top of arm64 defconfig for a general-purpose Linux guest in a protected
# Gunyah VM run by crosvm (wf/gvm, 23 Oct 2026). Everything needed to reach the root fs is built in (no initramfs).
# Protected VM: guest RAM is lent (host cannot read it), so every virtio buffer must bounce through crosvm's
# restricted-dma-pool (swiotlb) region: CONFIG_DMA_RESTRICTED_POOL is the one option distro kernels lack.
CONFIG_DMA_RESTRICTED_POOL=y
CONFIG_SWIOTLB=y
CONFIG_LOCALVERSION="-gvm"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# crosvm aarch64 machine: GICv3, arch timer, PSCI hvc, 8250 serial, pl030 rtc, generic PCI (CAM), virtio-pci/mmio
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL030=y
CONFIG_RTC_DRV_PL031=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# display: virtio-gpu (2D first; 3D/blob needs GuestAccept, later)
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=m
# file systems of the Fedora images (cloud: btrfs root + ext4 /boot + vfat ESP)
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_XFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_ZRAM=y
# systemd / Fedora userspace
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_FANOTIFY=y
CONFIG_USER_NS=y
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux,bpf"
CONFIG_NF_TABLES=m
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_VETH=m
# no hardware: drop what a VM never has to keep the image small
CONFIG_KVM=n
CONFIG_VIRTUALIZATION=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_SOUND_OSS_CORE=n
CONFIG_STAGING=n
# simplefb software display (iceland-vms 0.2-1, after DroidVM): simpledrm drives the shared framebuffer
CONFIG_DRM_SIMPLEDRM=y
